# Environment Variables

# Copy this file to .env.local and fill in the values

# Site URL (used for OG image generation, sitemap, etc.)
NEXT_PUBLIC_SITE_URL=https://umasuryateja.vercel.app

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Contact form (optional - for serverless email)
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
